{
  "components": {
    "schemas": {
      "AgeBody": {
        "properties": {
          "confirmed": {
            "title": "Confirmed",
            "type": "boolean"
          }
        },
        "required": [
          "confirmed"
        ],
        "title": "AgeBody",
        "type": "object"
      },
      "AnonAsk": {
        "properties": {
          "question": {
            "description": "The person's own words.",
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AnonAsk",
        "type": "object"
      },
      "AskBody": {
        "properties": {
          "audience": {
            "default": "layman",
            "enum": [
              "layman",
              "lawyer"
            ],
            "title": "Audience",
            "type": "string"
          },
          "question": {
            "description": "The person's own words.",
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskBody",
        "type": "object"
      },
      "AskChat": {
        "properties": {
          "intent": {
            "anyOf": [
              {
                "enum": [
                  "age_minor",
                  "charges"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "'age_minor': the person tapped 'under 18' on the age card; the server writes the question's words and asks what changes under POCSO (needs that answer in the case file). 'charges': the person pressed 'What else could he be charged with?' (lawyers' conversations; needs CHARGE_MAP and facts in the case file); the server writes the question.",
            "title": "Intent"
          },
          "question": {
            "description": "The person's own words.",
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskChat",
        "type": "object"
      },
      "CaseFileAnswer": {
        "properties": {
          "key": {
            "const": "victim_age",
            "title": "Key",
            "type": "string"
          },
          "value": {
            "enum": [
              "minor",
              "adult",
              "unknown"
            ],
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "CaseFileAnswer",
        "type": "object"
      },
      "CaseFileFact": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The id of a fact the person already sees; omit for a line they have just written.",
            "title": "Id"
          },
          "text": {
            "default": "",
            "maxLength": 2000,
            "title": "Text",
            "type": "string"
          }
        },
        "title": "CaseFileFact",
        "type": "object"
      },
      "ConsentBody": {
        "properties": {
          "document": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Document",
            "type": "string"
          },
          "version": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "document",
          "version"
        ],
        "title": "ConsentBody",
        "type": "object"
      },
      "CreateChat": {
        "properties": {
          "audience": {
            "default": "layman",
            "enum": [
              "layman",
              "lawyer"
            ],
            "title": "Audience",
            "type": "string"
          },
          "matter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "File the conversation under one of the person's own matters (404 for anyone else's).",
            "title": "Matter Id"
          },
          "title": {
            "default": "",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "CreateChat",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "kind": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "message_id": {
            "format": "uuid",
            "title": "Message Id",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "kind"
        ],
        "title": "FeedbackIn",
        "type": "object"
      },
      "GoogleBody": {
        "properties": {
          "id_token": {
            "maxLength": 8192,
            "minLength": 10,
            "title": "Id Token",
            "type": "string"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "GoogleBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MatterIn": {
        "properties": {
          "case_number": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Number"
          },
          "court": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "facts": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Facts"
          },
          "next_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Date"
          },
          "sections": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sections"
          },
          "stage": {
            "anyOf": [
              {
                "enum": [
                  "fir",
                  "arrest",
                  "remand",
                  "bail",
                  "chargesheet",
                  "trial",
                  "appeal",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "MatterIn",
        "type": "object"
      },
      "MatterPatch": {
        "description": "Only the fields that are sent change; null (or an empty text) clears a field except the title.",
        "properties": {
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "case_number": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Number"
          },
          "court": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "facts": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Facts"
          },
          "next_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Date"
          },
          "sections": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sections"
          },
          "stage": {
            "anyOf": [
              {
                "enum": [
                  "fir",
                  "arrest",
                  "remand",
                  "bail",
                  "chargesheet",
                  "trial",
                  "appeal",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "MatterPatch",
        "type": "object"
      },
      "NoteIn": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "message_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          }
        },
        "required": [
          "body"
        ],
        "title": "NoteIn",
        "type": "object"
      },
      "NotePatch": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "title": "NotePatch",
        "type": "object"
      },
      "PatchChat": {
        "properties": {
          "archived": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Archived"
          },
          "matter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Move the conversation under another of the person's matters; send null to take it out of its matter (only when the field is sent).",
            "title": "Matter Id"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "PatchChat",
        "type": "object"
      },
      "PutCaseFile": {
        "properties": {
          "facts": {
            "description": "The whole list as the person now sees it, in order. A fact missing from it is removed.",
            "items": {
              "$ref": "#/components/schemas/CaseFileFact"
            },
            "maxItems": 80,
            "title": "Facts",
            "type": "array"
          }
        },
        "title": "PutCaseFile",
        "type": "object"
      },
      "SearchBody": {
        "properties": {
          "court": {
            "anyOf": [
              {
                "enum": [
                  "sc",
                  "hc"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A judgments search for one court: 'sc' = the Supreme Court, 'hc' = a High Court (the wider search reads the Gauhati High Court only). Sections and Acts are not part of a court search. Omit it for the search as before.",
            "title": "Court"
          },
          "mode": {
            "default": "library",
            "enum": [
              "library",
              "wider"
            ],
            "title": "Mode",
            "type": "string"
          },
          "q": {
            "description": "What the person typed: a section, a case name, a citation or a few words. Only the first 300 characters are used.",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Q",
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "title": "SearchBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
