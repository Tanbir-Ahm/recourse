  "info": {
    "title": "Recourse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/anon/ask": {
      "post": {
        "description": "Layman answers only; three a day per device. Send 'Accept: text/event-stream' for the live steps; otherwise one JSON reply.",
        "operationId": "anon_ask_api_anon_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnonAsk"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask without signing in (free trial)"
      }
    },
    "/api/ask": {
      "post": {
        "description": "Send 'Accept: text/event-stream' for the live steps (events start, step, result, error, done); otherwise one JSON reply with the same result. Header X-API-Key is required.",
        "operationId": "ask_api_ask_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask one question"
      }
    },
    "/api/auth/google": {
      "post": {
        "operationId": "sign_in_google_api_auth_google_post",
        "requestBody": {
          "content": {
