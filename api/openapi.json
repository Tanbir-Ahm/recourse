            "default": "layman",
            "enum": [
              "layman",
              "lawyer"
            ],
            "title": "Audience",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "CreateChat",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
