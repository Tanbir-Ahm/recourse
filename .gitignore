.env
venv/
__pycache__/
*.pyc
temp_uploaded.pdf
compliance_brief.pdf
interview_brief*.pdf
temp_batch_*.pdf
test_brief.pdf
action_draft*.pdf
scratch_*.pdf

# citation_currency_checker.py output: regenerable, UNVERIFIED evidence
# bundles. A human reads these and writes the curated
# CITATION_CURRENCY_MAP entry by hand -- the bundle itself is a working
# artifact, not a source of truth, so it is not tracked.
citation_currency_review/

# eval_chat_answers.py output: regenerable run reports (each run makes
# live API calls). Keep locally for before/after comparison; not tracked.
eval_out/

# eval_related_judgments.py (Lane B eval harness) output: same deal --
# regenerable run reports, live API calls in live mode. Not tracked.
eval_related_out/

# related_judgments.py (Lane B) output: regenerable, UNVERIFIED candidate
# bundles from live Indian Kanoon searches. A human reads these to curate
# genuinely-good judgments into the corpus by hand -- the bundle is a
# working artifact, not a source of truth. Not tracked.
related_judgments_review/

# related_judgments.py user-approved store: judgments a user kept in a
# prepared draft, cached so a similar question retrieves them instantly.
# Per-user, still UNVERIFIED, never feeds the grounded answer. Not tracked.
related_judgments_approved.json

# corpus-seeding pilot: scratch scrape of raw fetched paragraph text used
# while curating a batch into corpus/+chunks/. Once approved paragraphs
# are written to corpus/chunks, this working file is redundant.
seed_full_text*.json

# submission working files (screenshots, gallery framing) -- not part of the app
tool_snapshots/

# whatsapp_store.py's local SQLite conversation history. Once real, this
# holds real people's real legal/arrest situations, phone numbers
# included -- must never be tracked, even in local dev.
*.db
